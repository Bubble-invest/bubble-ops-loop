# Recurring mission — generated by department-onboarding-guide (Step 2).
# Notion v5 lines 830-846; conforms to recurring-mission.schema.yaml.
id: {{ mission.id }}
# Optional alignment (Tony owns the mapping; missing fields remain unmapped).
# business_unit: steering  # fund | ai_methods | pro_clients | steering
# serves_intents: [operator-intent-slug]  # shared/operator-intents/<slug>.md
# floor: measure  # distribute | package | produce | measure
{% if mission.business_unit is defined %}business_unit: {{ mission.business_unit | tojson }}
{% endif %}
{% if mission.serves_intents is defined %}serves_intents: {{ mission.serves_intents | tojson }}
{% endif %}
{% if mission.floor is defined %}floor: {{ mission.floor | tojson }}
{% endif %}
layer: {{ mission.layer }}
cadence: {{ mission.cadence }}
{% if mission.time is defined %}time: "{{ mission.time }}"
{% endif %}
{% if mission.day is defined %}day: {{ mission.day }}
{% endif %}
{% if mission.active_hours is defined %}active_hours: "{{ mission.active_hours }}"
{% endif %}
description: "{{ mission.description }}"
{% if mission.input_sources is defined %}
input_sources:
{% for src in mission.input_sources %}
  - {{ src }}
{% endfor %}
{% endif %}
output_queue: {{ mission.output_queue }}
creates:
{% for k in mission.creates %}
  - {{ k }}
{% endfor %}
{% if mission.gate_policy_id is defined %}gate_policy_id: {{ mission.gate_policy_id }}
{% endif %}

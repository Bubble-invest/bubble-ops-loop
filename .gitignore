# Python
venv/
__pycache__/
*.pyc
.pytest_cache/

# Backups (session-local)
*.bak
*.bak-*
*.bak/

# Runtime / secrets (never commit)
*.env
.env
*.sops.env
*credentials*
# guard-stale-credentials.sh is a GUARD script (not a credential file) — keep it tracked
# (board #1150: moved from deploy/bin/ to scripts/ — see deploy/bin/README.md)
!scripts/guard-stale-credentials.sh
*.pem
*.key
*.private*
# Decision-signing Ed25519 PUBLIC key (board #1476/#1498) — content is safe
# to commit (only the matching PRIVATE key, SOPS-encrypted VPS-only, can
# produce a signature it accepts); see scripts/keys/README.md.
!scripts/keys/decision-signing-ed25519.pub.pem

# Local lock/state
*.lock
# loop-backup runtime event log (cockpit reads it; per-box, not versioned)
state/
.venv/

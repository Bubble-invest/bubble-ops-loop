# /etc/systemd/system/ops-loop-${DEPT_SLUG}.service
# Bubble Ops-Loop systemd unit — UX-5 deploy template.
# Source: STEP-7-DEPLOYMENT-RESULTS.md (fixture pattern, verified working).
#
# Placeholders (substituted by scripts/deploy-to-morty.sh):
#   ${DEPT_SLUG}            kebab-case dept slug (e.g. "miranda")
#   ${TELEGRAM_STATE_DIR}   /home/claude/.claude/channels/telegram-<slug>
#   ${ENV_FILE}             /run/claude-agent-<slug>/env
#
# Doctrine references:
#   - SPEC-007 + SPEC-009 (Claude agent systemd recipe)
#   - bubble-vps-platform/hetzner-migration/CLAUDE_AGENT_RECIPE.md
#   - STEP-7-DEPLOYMENT-RESULTS.md (fixture deployment proof)
#
# Critical invariants:
#   - Use dtach(1) -N for pty allocation (board #1097, 2026-09-03 — supersedes
#     /usr/bin/script; avoid pty wrappers that break the OAuth/auth flow).
#     dtach is ALSO attachable (`dtach -a <sock>`, via the fleet terminal
#     tool), which /usr/bin/script's pty was not.
#   - Use the interactive claude binary with --dangerously-skip-permissions
#     plus --channels plugin:telegram@claude-plugins-official.
#   - Per-dept SOPS env at /etc/bubble/secrets-<slug>.sops.env.
#
# ============================================================================
# DOCTRINE — two INDEPENDENT runtime bans below (Ban #1 and Ban #2).
# Different root causes, different fixes. Read both paragraphs in full
# before deviating from either. Adopting one does NOT avoid the other's
# failure mode.
# ============================================================================
#
# Ban #1 — NO tmux inside this unit (empirical tooling regression).
#   Rule:        ExecStart must NOT spawn or attach to a tmux session.
#                Use dtach -N for pty allocation instead (board #1097 —
#                previously /usr/bin/script -qfc; both are non-tmux ptys).
#   Root cause:  Claude Code v2.1.139 returns HTTP 404 "issue with the
#                selected model" on EVERY model for any fresh session
#                started inside a tmux pty on Linux. Direct ssh shells
#                are unaffected. Pure CLI bug, not a contract choice.
#   Evidence:    STEP-4-SMOKE-TEST-RESULTS.md (~90 min diagnosis;
#                7 model/wrapper combinations all 404 inside tmux).
#                Also catalogued in docs/ARCHITECTURE.md
#                §6 "Failure modes catalogue" row #1.
#   Alternative: dtach -N <sock> (used below in ExecStart, board #1097) gives
#                a real, ATTACHABLE pty without triggering the resolver bug
#                (validated live on all 5 VPS depts 2026-09-03, zero 404s —
#                dtach != tmux). /usr/bin/script also worked here but was
#                not attachable; see shared-wiki
#                shared/systems/fleet-terminal-tool.md.
#
# Ban #2 — NO `claude -p` headless mode (product policy + hooks loss).
#   Rule:        ExecStart must invoke the INTERACTIVE binary (with
#                --dangerously-skip-permissions + --channels …),
#                NEVER `claude -p` / `claude --print`.
#   Root cause:  Two unrelated reasons stacked on the same flag:
#                  (a) Anthropic is moving `-p` (print / headless) to
#                      a paid tier mid-June 2026 — Claude Max plans
#                      lose access.
#                  (b) Headless mode DISABLES Claude Code hooks. Our
#                      unit depends on hooks for env-read-alert and
#                      bash-validator; running `-p` silently breaks
#                      those guards.
#   Evidence:    STEP-7-DEPLOYMENT-RESULTS.md (`claude -p` headless
#                doctrine); docs/ARCHITECTURE.md §6 row #2.
#   Alternative: interactive `claude --dangerously-skip-permissions
#                --channels plugin:telegram@claude-plugins-official`
#                (used below in ExecStart). Driven by SessionStart hook
#                + /loop for cadence.
# ============================================================================
[Unit]
Description=Claude Agent — ops-loop-${DEPT_SLUG} (bubble-ops-loop, dept=${DEPT_SLUG})
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=claude
Group=claude
WorkingDirectory=/home/claude/agents/${DEPT_SLUG}

# dtach interactive-terminal support (board #1097 — folds in the 2026-09-03
# live hand-edit so a deploy-to-morty.sh re-render doesn't revert it; see
# shared-wiki shared/systems/fleet-terminal-tool.md).
# RuntimeDirectory= makes systemd create /run/ops-loop-${DEPT_SLUG} (owned by
# User=/Group= above, i.e. `claude`) BEFORE ExecStart runs. This is
# load-bearing: claude/dtach cannot mkdir a dir under /run itself (root-owned
# tmpfs), so WITHOUT this the ExecStart below crash-loops — the socket is
# never created. `fleet`/an operator then attaches with
# `dtach -a /run/ops-loop-${DEPT_SLUG}/dtach.sock`.
RuntimeDirectory=ops-loop-${DEPT_SLUG}

# /opt/bubble-token-broker/bin is PREPENDED so git-guard's default broker lookup
# (`bubble-token-broker`, resolved via PATH) finds the binary — it lives there,
# not in a standard PATH dir. Without this: "broker binary not found" (blocker #2
# of the 2026-06-04 runtime-push outage).
Environment=PATH=/opt/bubble-token-broker/bin:/home/claude/.bun/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/bin
Environment=BUBBLE_DEPT=${DEPT_SLUG}
Environment=TELEGRAM_STATE_DIR=${TELEGRAM_STATE_DIR}

# /loop boot RE-ARM (supersedes bubble-loop-reinit.sh). On poller startup the
# telegram channel plugin self-injects ONE synthetic "boot" turn straight into
# Claude via the same MCP channel notification a real inbound message uses
# (boot_rearm.ts -> bootRearmNotification). That turn makes the agent re-run
# session-start + re-register its /loop after ANY restart -- without depending on
# a bot->{{OPERATOR}} Telegram message (which never returns as an inbound update; that
# was the bug bubble-loop-reinit.sh could not fix). Fires ONLY when
# OPS_LOOP_BOOT_REARM=1 (interactive Mac/Telegram sessions must never auto-fire).
# Requires the plugin to be patched on the box: scripts/install-boot-rearm.sh.
# OPS_LOOP_DEPT is threaded into the boot turn's meta for journald correlation.
Environment=OPS_LOOP_BOOT_REARM=1
Environment=OPS_LOOP_DEPT=${DEPT_SLUG}

# PEM pre-decryption: broker (running as `claude`) cannot read
# /etc/age/key.txt (root-only), so we decrypt the GitHub App private key
# here as root and chown to claude. The broker wrapper auto-detects
# BUBBLE_BROKER_PEM_PATH and passes --no-sops to skip SOPS at mint time.
# G-4 fix (GAP-10): these 3 blocks were present in the live fixture unit
# but missing from this template — required for any dept to mint broker
# tokens (Tony, Maya, Ben, etc.).
Environment=BUBBLE_BROKER_PEM_PATH=/run/bubble-${DEPT_SLUG}/pem
Environment=GITHUB_APP_PRIVATE_KEY_PATH=/run/bubble-${DEPT_SLUG}/pem
# GITHUB_APP_ID: the bubble-ops-bot GitHub App id. NOT a secret (the broker's
# own --help prints it as the example). The broker (`cli.py::_resolve_app_id`)
# raises "Missing GITHUB_APP_ID env or --app-id" without it, so EVERY runtime
# push fails the token mint — the G-4/GAP-10 fix added the PEM but forgot this
# id, leaving tony/ben/maya unable to push (commits stranded for days,
# 2026-06-04). Static + public → safe to bake into the unit template.
Environment=GITHUB_APP_ID=3782718
# GITHUB_APP_INSTALLATION_ID_<DEPT>: the Bubble-invest org install id (135214360,
# from the working credential-helper). Broker `cli.py::_resolve_installation_id`
# reads GITHUB_APP_INSTALLATION_ID_${DEPT_SLUG^^} (dashes→underscores) and raises
# "Could not resolve installation ID" without it (blocker #3 of the 2026-06-04
# outage). Public, not a secret. NOTE: the var NAME is dept-suffixed — the
# renderer must upper-case ${DEPT_SLUG} and replace '-' with '_'.
Environment=GITHUB_APP_INSTALLATION_ID_${DEPT_SLUG_UPPER}=135214360
Environment=BUBBLE_BROKER_JOURNAL=on

# Tmpfs runtime dir with per-dept isolation (mirrors morty's pattern).
ExecStartPre=+/bin/mkdir -p /run/claude-agent-${DEPT_SLUG}
ExecStartPre=+/bin/chown claude:claude /run/claude-agent-${DEPT_SLUG}
ExecStartPre=+/bin/chmod 0750 /run/claude-agent-${DEPT_SLUG}

# Decrypt SOPS env file into tmpfs (root-only step).
ExecStartPre=+/bin/sh -c 'SOPS_AGE_KEY_FILE=/etc/age/key.txt /usr/local/bin/sops --decrypt --output /run/claude-agent-${DEPT_SLUG}/env.raw.tmp /etc/bubble/secrets-${DEPT_SLUG}.sops.env'

# Per-dept token rewrite: drop morty's TELEGRAM_BOT_TOKEN= line (if any)
# and promote DEPT-prefixed bot token to TELEGRAM_BOT_TOKEN= so the
# plugin reads the right token.
ExecStartPre=+/bin/sh -c 'grep -v "^TELEGRAM_BOT_TOKEN=" /run/claude-agent-${DEPT_SLUG}/env.raw.tmp | sed "s/^DEPT_TELEGRAM_BOT_TOKEN=/TELEGRAM_BOT_TOKEN=/" > /run/claude-agent-${DEPT_SLUG}/env.tmp'
ExecStartPre=+/bin/rm /run/claude-agent-${DEPT_SLUG}/env.raw.tmp
ExecStartPre=+/bin/mv /run/claude-agent-${DEPT_SLUG}/env.tmp ${ENV_FILE}
ExecStartPre=+/bin/chmod 0400 ${ENV_FILE}
ExecStartPre=+/bin/chown claude:claude ${ENV_FILE}

# Decrypt PEM into /run/bubble-<slug>/pem (claude-readable tmpfs).
ExecStartPre=+/bin/mkdir -p /run/bubble-${DEPT_SLUG}
ExecStartPre=+/bin/chown claude:claude /run/bubble-${DEPT_SLUG}
ExecStartPre=+/bin/chmod 0750 /run/bubble-${DEPT_SLUG}
ExecStartPre=+/bin/sh -c 'SOPS_AGE_KEY_FILE=/etc/age/key.txt /usr/local/bin/sops --decrypt --input-type binary --output-type binary --output /run/bubble-${DEPT_SLUG}/pem.tmp /srv/bubble-secrets/github-app-bubble-ops-bot.private-key.sops.pem'
ExecStartPre=+/bin/mv /run/bubble-${DEPT_SLUG}/pem.tmp /run/bubble-${DEPT_SLUG}/pem
ExecStartPre=+/bin/chmod 0400 /run/bubble-${DEPT_SLUG}/pem
ExecStartPre=+/bin/chown claude:claude /run/bubble-${DEPT_SLUG}/pem

# Re-vendor the canonical shared libs (dispatch_helpers/notify*/notion_logbook +
# tools/notify_layer) from the framework at EVERY start, so they can never drift
# stale via a checkout/reset/reclone ({{OPERATOR}} 2026-06-07: safe_pull + min-time model
# silently reverted fleet-wide because vendored on-disk, not committed). Fail-open.
ExecStartPre=+/usr/local/bin/vendor-dept-libs.sh /home/claude/agents/${DEPT_SLUG}

# Re-apply BOTH telegram-plugin patches (bubble-inject — delivers a message into
# this live session as if from {{OPERATOR}} — and boot_rearm, see the OPS_LOOP_BOOT_REARM
# block above) on every start — self-heals after a plugin update, which WIPES the
# plugin cache dir (board #956, superseding the one-off manual re-apply in #1047 and
# the VPS-only, boot_rearm-blind scripts/apply-inject-patch.sh it replaces here).
# Idempotent, `bun build`-validated, fail-open (never blocks a dept from starting).
# Canonical source: scripts/install-channel-patches.sh.
ExecStartPre=+/usr/local/bin/install-channel-patches.sh

# Guard against a stale ~/.claude/.credentials.json SHADOWING the env CLAUDE_CODE_OAUTH_TOKEN
# (board #294 / incident 2026-06-25: the shared on-disk creds expired and 401'd all 5 depts,
# because claude prefers the on-disk file over the env token). Moves a shadowing file aside
# ONLY when the env token exists to fall back to. Reversible, fail-open, never echoes secrets.
ExecStartPre=+/usr/local/bin/guard-stale-credentials.sh ${ENV_FILE}

EnvironmentFile=-${ENV_FILE}

# Use dtach(1) for pty allocation (board #1097 — replaces script(1); see the
# RuntimeDirectory= comment above for the crash-loop gotcha this depends on).
# `-N` (capital) is REQUIRED, not `-n`: `-N` keeps dtach in the FOREGROUND
# so systemd's Type=simple can supervise it as the main PID; `-n` forks and
# detaches immediately, which would make systemd think the service exited.
# `fleet`/an operator attaches a real interactive terminal via
# `dtach -a /run/ops-loop-${DEPT_SLUG}/dtach.sock` (Ctrl-\ to detach, NOT
# Ctrl-C — that signals the agent). Validated live on all 5 VPS depts
# 2026-09-03, zero regressions (dtach's pty does not trigger the tmux-404 bug
# below — dtach != tmux).
#
# --model "${CLAUDE_MODEL}" pins the per-dept model at the unit level (belt-and-
# suspenders after the 2026-05-31 "default"-model 404 outage, where a fresh
# session resolved to the literal model "default" and 404'd). deploy-to-morty.sh
# substitutes ${CLAUDE_MODEL} from --model (default opus[1m]); the canonical
# per-dept declaration is department.model in dept.yaml (-> .claude/settings.json
# via isolation_scaffold.model_from_dept_yaml). Fleet cost-optimization
# (2026-06-19): cheap-orchestrator depts pin "sonnet[1m]" and spawn Opus
# subagents for heavy reasoning; Opus-pinned depts keep "opus[1m]".
ExecStart=/bin/sh -c 'exec /usr/bin/dtach -N /run/ops-loop-${DEPT_SLUG}/dtach.sock /bin/sh -c "/usr/bin/claude --model \"${CLAUDE_MODEL}\" --dangerously-skip-permissions --channels plugin:telegram@claude-plugins-official"'

# G-3 fix (GAP-10): On EVERY service start (including after Restart=on-failure),
# send a Telegram message via the dept's own bot to trigger a new /loop turn.
# Without this, a session crash leaves the agent idle indefinitely (it waits
# at the input prompt — the session-start hook fires but has no turn to process).
# bubble-loop-reinit.sh reads the bot token from ${ENV_FILE} (never echoes it),
# curls Telegram sendMessage, which causes an incoming turn, which re-registers
# the /loop cron. The 5s sleep lets the Claude TUI settle before the curl fires.
ExecStartPost=+/bin/sleep 5
ExecStartPost=+/usr/local/bin/bubble-loop-reinit.sh ${DEPT_SLUG}

Restart=on-failure
RestartSec=10
LimitNOFILE=65536

ExecStopPost=+/bin/rm -f ${ENV_FILE} /run/bubble-${DEPT_SLUG}/pem


# Boot-rearm via inject file (ExecStartPost, in [Service]). The MCP notification
# in onStart fires too early (during session init). Instead, wait for the poller
# to start watching the inject file, then write the boot message there.
# Self-paced (2026-06-27): the agent picks its own next wake; no hardcoded hourly cron.
#
# Manifest re-arm (board #461, child of #456): a systemd restart is a brand-new
# process, so ANY durable cron armed only via CronCreate (not just /loop itself —
# e.g. a dept's fixed-time daily brief) is silently lost with it (see
# schemas-draft/crons-manifest.schema.yaml + scripts/lib/crons_manifest.py).
# The SAME boot turn below now also tells the agent to self-heal those: load its
# OWN config/crons.yaml (if present — a dept with none is a no-op) and re-create
# via CronCreate whatever CronList shows missing. This generalizes boot-rearm
# beyond "/loop only" without touching mission-dispatch logic.
ExecStartPost=/bin/sh -c "sleep 8 && printf 'Resume your OODA loop. You woke via --resume so you have full context. FIRST run ONE normal session-start + dispatch tick now (STEP A-F per CLAUDE.md) — do this unconditionally on boot/heal; the floor timers are a net, not a substitute. THEN arm your OWN next wake with a single CronCreate (run CronList first and delete any stale/duplicate loop task so you never stack two). The box clock is UTC, not Paris: NEVER hand-write a Paris HH:MM as the cron literal (board #850 — treating 08:03 Paris as 3 8 * * * fired a live market order 2h late). For any Paris-anchored target, derive the box-UTC cron via scripts/arm-wake-cron.sh Paris-HH:MM [daily|one-shot] (DST-safe, reads the tz database, never a hardcoded offset) and CronCreate the printed expression; sanity-check with TZ=Europe/Paris date at tick start: work pending or a layer still due today -> schedule toward that layer time; quiet but more may come today -> a longer cadence is fine (e.g. 0 */2 * * *, TZ-neutral); all 4 layers done and nothing explicitly awaited -> run scripts/arm-wake-cron.sh 08:03 one-shot for the correct box-UTC one-shot and arm nothing else. Never hardcode an hourly cron. The CronCreate prompt must be your full tick protocol (STEP A-F), never a bare slash-command like /loop-now (it delivers as a malformed inbound that can trip the deaf-watchdog). Your loop-layer floor timers remain the guaranteed safety net. THEN check for a declarative cron manifest at config/crons.yaml in your dept repo (absent file = nothing else to do here): if present, run CronList, and for EACH manifest entry whose name is missing from the live list, CronCreate it with that entry'\\''s schedule + resolved prompt (a prompt_ref starting with file: means read that file relative to your dept dir for the full prompt text) — this is idempotent, so only create what is actually missing, never a duplicate of one already live. If a manifest entry marked critical: true is STILL missing after your re-arm attempt (e.g. CronCreate itself failed), send ONE loud Telegram alert naming it — do not stay silent on a critical miss.\\n' >> ${TELEGRAM_STATE_DIR}/inject"


# Notion logbook agent identity. The shared notion_logbook.py uses this to
# set the Agent select column in the shared "Agent Logbook" DB so every
# dept's entries are attributed correctly.
Environment=LOGBOOK_AGENT_ID=${DEPT_SLUG}
[Install]
WantedBy=multi-user.target



# --- _lll_write_state_env <target-file> <VAR> [<VAR> ...] (board #1548) -----
# Atomically upsert one or more KEY=VALUE lines into <target-file> (normally
# $TELEGRAM_STATE_DIR/.env) using the CURRENT value of each named shell
# variable in THIS process's own env (already loaded above by the vault /
# legacy-.env block) — never by putting that value into the claude REPL env,
# which every Agent-tool subagent + its Bash subshells inherit (board #1548).
# A plain KEY=VALUE line is written as DATA; nothing here is ever sourced or
# eval'd, mirroring _lll_load_secrets_safe's "never execute untrusted content"
# rule for the write side.
#   - every OTHER line already in the file (comments, blanks, unrelated keys)
#     is preserved verbatim, in its original order;
#   - a managed VAR whose CURRENT value is empty is left alone — whatever is
#     already on disk for that key stays untouched rather than being
#     clobbered with a blank (e.g. a run where the vault yielded nothing);
#   - written via a fresh temp file in the SAME directory (same filesystem,
#     so the final `mv` is atomic), created under `umask 077` plus an
#     explicit `chmod 600` belt-and-suspenders, mirroring the vault-decrypt
#     tmpfile pattern used elsewhere in this wrapper.
_lll_write_state_env() {
  local _target="$1"; shift
  local _dir _tmp _line _key _managed _v _val _pending
  _dir="$(dirname "$_target")"
  (umask 077 && mkdir -p "$_dir") 2>/dev/null
  _tmp="$(umask 077 && mktemp "${_dir}/.$(basename "$_target").XXXXXX")" || return 1
  chmod 600 "$_tmp" 2>/dev/null
  _pending="$*"
  if [ -f "$_target" ]; then
    while IFS= read -r _line || [ -n "$_line" ]; do
      case "$_line" in
        ''|'#'*) printf '%s\n' "$_line" >> "$_tmp"; continue ;;
      esac
      _key="${_line%%=*}"
      _managed=0
      for _v in $_pending; do
        [ "$_key" = "$_v" ] && _managed=1
      done
      [ "$_managed" = "1" ] || printf '%s\n' "$_line" >> "$_tmp"
    done < "$_target"
  fi
  for _v in $_pending; do
    _val="${!_v:-}"
    [ -n "$_val" ] && printf '%s=%s\n' "$_v" "$_val" >> "$_tmp"
  done
  chmod 600 "$_tmp" 2>/dev/null
  mv -f "$_tmp" "$_target"
}

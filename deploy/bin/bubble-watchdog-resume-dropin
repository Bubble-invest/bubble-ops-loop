#!/usr/bin/env bash
# /usr/local/bin/bubble-watchdog-resume-dropin
# Managed by bubble-vps-platform (SPEC-021 FIX-6, hardened per Codex P1 review
# 2026-06-01; board #1100 — derive-from-unit 2026-09-03). Do NOT edit by hand.
#
# ROOT-OWNED helper that installs/removes the watchdog's TRANSIENT resume
# drop-in. The telegram-watchdog runs as the unprivileged `claude` user and
# calls this via a tightly-scoped sudoers rule
# (`sudo /usr/local/bin/bubble-watchdog-resume-dropin install|remove <svc>`).
#
# WHY THIS EXISTS (the vuln it closes): the previous design granted `claude`
# `sudo /usr/bin/tee <dropin>` with ARBITRARY stdin + `sudo systemctl
# daemon-reload`/`start`. Pinning the filename did NOT constrain the file
# CONTENTS, so a compromised `claude` account could write an attacker-controlled
# `[Service]` block (e.g. `ExecStart=… as root`, or `User=root`) and escalate to
# root via systemd. This helper removes that: the drop-in content is produced by
# this root-owned script (claude cannot edit it), and the ONLY caller input is
# the service NAME, validated against a strict allowlist. There is no path by
# which the caller controls a single byte of the unit override.
#
# WHAT CHANGED (board #1100): the drop-in ExecStart used to be a HARDCODED
# literal —
#     /usr/bin/script -qfc "/usr/bin/claude --continue --fork-session \
#         --model \"opus[1m]\" …" /dev/null
# — which had two bugs against the current runtime:
#   1. It relaunched the dept under `script` (a NON-attachable pty), silently
#      REVERTING the dtach interactive-terminal durability shipped in board
#      #1097 (units now launch `dtach -N /run/<unit>/dtach.sock …`). A watchdog
#      recovery would bring the dept back OFF dtach — losing its attachable
#      socket and reintroducing the tmux/script-family 404 risk — until the next
#      normal restart.
#   2. It hardcoded a drifting short model id `opus[1m]` that can diverge from
#      the unit's real pinned model (violating the no-model-drift / no-Opus-5
#      pin), and is simply WRONG for the claude-agent-* units, which pin their
#      model elsewhere and carry no `--model` in ExecStart at all.
#
# THE FIX: instead of hardcoding a launch line, DERIVE it from the unit's OWN
# ExecStart (read from the unit's root-owned fragment file — a TRUSTED source;
# `claude` cannot edit /etc/systemd/system) and inject ONLY the resume flags
# `--continue --fork-session` after the claude binary. The transient drop-in
# therefore inherits the unit's launcher (dtach), its /run/<unit>/dtach.sock
# socket, its `--model`, and its `--channels` VERBATIM — zero drift, and it can
# never revert dtach. The caller still controls only the allowlisted SERVICE
# name; no caller byte reaches the override, so the Codex-P1 property holds.
set -euo pipefail

ACTION="${1:-}"
SERVICE="${2:-}"

# ── Test-only seams (inert in production). `claude` invokes this via sudo, which
#    resets the environment (env_reset), so these overrides cannot be supplied by
#    the caller in the live path — they default to the real production values.
#    The test harness (which runs the script DIRECTLY, not via sudo) uses them to
#    point at a fake `systemctl` + a temp drop-in root, so the derive/inject
#    logic can be exercised without root or a live systemd.
SYSTEMCTL_BIN="${BUBBLE_WATCHDOG_SYSTEMCTL:-/usr/bin/systemctl}"
DROPIN_ROOT="${BUBBLE_WATCHDOG_DROPIN_ROOT:-/etc/systemd/system}"

# ── Allowlist the service name. Only the known dept/concierge unit-name shapes
#    are accepted; anything else is rejected. No wildcards, no path traversal
#    (the name can't contain '/', '..', spaces, or metacharacters and still
#    match this anchored pattern).
if ! [[ "$SERVICE" =~ ^(ops-loop-[a-z0-9]+|claude-agent-[a-z0-9]+)\.service$ ]]; then
    echo "bubble-watchdog-resume-dropin: refusing — service name '$SERVICE' not in allowlist" >&2
    exit 2
fi

DROPIN_DIR="${DROPIN_ROOT}/${SERVICE}.d"
DROPIN="${DROPIN_DIR}/zz-watchdog-resume.conf"

case "$ACTION" in
  install)
    mkdir -p "$DROPIN_DIR"

    # (1) Resolve the unit's MAIN fragment file (root-owned, trusted). Using the
    #     fragment (not a drop-in) means we read the CANONICAL ExecStart, not a
    #     lingering resume override from a prior recovery.
    FRAG="$("$SYSTEMCTL_BIN" show "$SERVICE" -p FragmentPath --value)"
    if [[ -z "$FRAG" || ! -f "$FRAG" ]]; then
        echo "bubble-watchdog-resume-dropin: cannot resolve a fragment file for '$SERVICE' (got '${FRAG:-}') — refusing (would weaken recovery)" >&2
        exit 3
    fi

    # (2) Take the single ACTIVE ExecStart= line (skip the empty reset lines that
    #     only appear in drop-ins). Strip the leading `ExecStart=`.
    UNIT_EXEC="$(grep -E '^ExecStart=.+' "$FRAG" | head -n1)"
    UNIT_EXEC="${UNIT_EXEC#ExecStart=}"
    if [[ -z "$UNIT_EXEC" ]]; then
        echo "bubble-watchdog-resume-dropin: no ExecStart found in fragment '$FRAG' for '$SERVICE' — refusing" >&2
        exit 3
    fi

    # (3) Inject the resume flags immediately AFTER the claude binary (matched as
    #     an absolute path ending in /claude, e.g. /usr/bin/claude). Everything
    #     else — dtach, the socket path, --model, --channels — is inherited
    #     verbatim. Fail CLOSED if the binary token isn't found, so we never emit
    #     a drop-in that silently drops --continue (start-blank) or is malformed.
    RESUME_EXEC="$(printf '%s' "$UNIT_EXEC" | sed -E 's@(/[[:alnum:]/_.-]*/claude) @\1 --continue --fork-session @')"
    if [[ "$RESUME_EXEC" == "$UNIT_EXEC" || "$RESUME_EXEC" != *"--continue --fork-session"* ]]; then
        echo "bubble-watchdog-resume-dropin: could not locate the claude binary in the unit ExecStart to inject resume flags — refusing (would weaken recovery)" >&2
        exit 3
    fi

    # (4) Write the transient override. The ExecStart is DERIVED (step 3), never
    #     caller-supplied. printf %s emits $RESUME_EXEC literally — no re-parsing
    #     of any caller input.
    {
        printf '%s\n' "# TRANSIENT — written by bubble-watchdog-resume-dropin before a watchdog"
        printf '%s\n' "# recovery restart so the agent RESUMES its session instead of starting blank."
        printf '%s\n' "# Removed immediately after the restart. Safe to delete + daemon-reload if"
        printf '%s\n' "# seen lingering (means the watchdog died mid-recovery)."
        printf '%s\n' "#"
        printf '%s\n' "# ExecStart is DERIVED from the unit's OWN ExecStart (board #1100) + the"
        printf '%s\n' "# --continue --fork-session resume flags, so it inherits the unit's dtach"
        printf '%s\n' "# launcher, /run/<unit>/dtach.sock socket, --model and --channels verbatim."
        printf '%s\n' "[Service]"
        printf '%s\n' "ExecStart="
        printf 'ExecStart=%s\n' "$RESUME_EXEC"
    } > "$DROPIN"

    chmod 0644 "$DROPIN"
    "$SYSTEMCTL_BIN" daemon-reload
    echo "bubble-watchdog-resume-dropin: installed $DROPIN"
    ;;
  remove)
    rm -f "$DROPIN"
    "$SYSTEMCTL_BIN" daemon-reload
    echo "bubble-watchdog-resume-dropin: removed $DROPIN"
    ;;
  *)
    echo "usage: bubble-watchdog-resume-dropin install|remove <service>" >&2
    exit 64
    ;;
esac

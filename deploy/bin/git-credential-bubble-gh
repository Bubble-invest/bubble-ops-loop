#!/usr/bin/env bash
# Git credential wrapper: prefer the policy-aware root helper, then fall back
# to the caller's pre-minted, repository-read-only token under /run.

ACTION="${1:-get}"
if [ "$ACTION" != "get" ]; then
  exit 0
fi

# Buffer git's credential protocol exactly once.  The sentinel preserves its
# trailing blank line, and likewise preserves the helper's trailing newlines.
_sentinel=$'\036'
_stdin_with_sentinel="$(cat; printf '%s' "$_sentinel")"
STDIN_BUF=${_stdin_with_sentinel%"$_sentinel"}

_primary_with_sentinel="$({
  printf '%s' "$STDIN_BUF" | \
    sudo -n /usr/local/bin/bubble-gh-credential-helper.sh get 2>/dev/null
  printf '%s' "$_sentinel"
})"
PRIMARY_OUTPUT=${_primary_with_sentinel%"$_sentinel"}

# Only trust the primary response when it actually contains a credential.
if [[ $'\n'"$PRIMARY_OUTPUT"$'\n' == *$'\npassword='* ]]; then
  printf '%s' "$PRIMARY_OUTPUT"
  exit 0
fi

CALLER=$(id -un 2>/dev/null || true)
case "$CALLER" in
  agent-*) _dept=${CALLER#agent-} ;;
  *) exit 0 ;;
esac
[[ "$_dept" =~ ^[a-z0-9][a-z0-9-]*$ ]] || exit 0

TOKEN_DIR="${BUBBLE_GIT_READ_TOKEN_RUN_DIR:-/run/bubble-git}"
TOKEN_FILE="${TOKEN_DIR%/}/token.${_dept}"
[ -r "$TOKEN_FILE" ] && [ -s "$TOKEN_FILE" ] || exit 0
TOKEN=$(<"$TOKEN_FILE")
[ -n "$TOKEN" ] || exit 0

printf 'username=x-access-token\n'
printf 'password=%s\n' "$TOKEN"
